# ==============================================================================
# EMS CRM & GHL Integration Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_here

# Database Configuration (Defaults to database.sqlite in root)
DB_PATH=database.sqlite

# GoHighLevel (GHL) Marketplace App Configuration
# Register your app at https://developers.gohighlevel.com
GHL_CLIENT_ID=your_ghl_app_client_id
GHL_CLIENT_SECRET=your_ghl_app_client_secret
GHL_REDIRECT_URI=https://staging.employeemanagementsystems.com/api/v1/integrations/oauth/callback
GHL_SCOPES=contacts.readonly contacts.write conversations.readonly conversations.write locations.readonly workflows.readonly
GHL_TOKEN_ENCRYPTION_KEY=your_32_byte_aes_encryption_key_here

# Stripe Billing (Optional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Telephony - Voxbay Configuration (Managed via DB / env fallback)
VOXBAY_API_BASE_URL=https://x.voxbay.com/api/click_to_call
VOXBAY_RECORDING_BASE_URL=https://x.voxbay.com:81/callcenter/
VOXBAY_UID=
VOXBAY_UPIN=
VOXBAY_DID=

# Voice AI (Optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
