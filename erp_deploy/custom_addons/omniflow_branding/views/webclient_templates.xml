<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Replace Page Title Everywhere -->
    <template id="web_layout_branding" inherit_id="web.layout">
        <xpath expr="//title" position="replace">
            <title>EMS</title>
        </xpath>
        <xpath expr="//link[@type='image/x-icon']" position="replace">
            <link type="image/x-icon" rel="shortcut icon" href="https://app.employeemanagementsystems.com/favicon.ico"/>
        </xpath>
        <xpath expr="//head" position="inside">
            <link rel="icon" type="image/svg+xml" href="https://app.employeemanagementsystems.com/favicon.ico"/>
            <style><![CDATA[
                /* Instant CSS Fallback and Overrides */
                .o_main_navbar {
                    background-color: #0f2b26 !important;
                    background: linear-gradient(135deg, #0f2b26 0%, #064e43 100%) !important;
                    border-bottom: 1px solid rgba(20, 210, 203, 0.25) !important;
                }
                .o_main_navbar .o_menu_brand {
                    color: #14d2cb !important;
                    font-weight: 800 !important;
                    letter-spacing: 0.5px !important;
                }
                .o_main_navbar .o_nav_entry, .o_main_navbar .dropdown-toggle {
                    color: #f8fafc !important;
                }
                .btn-primary, .btn-primary:active {
                    background: linear-gradient(135deg, #0d9488 0%, #064e43 100%) !important;
                    border-color: #0d9488 !important;
                    color: #ffffff !important;
                    box-shadow: 0 4px 12px rgba(13, 148, 136, 0.25) !important;
                }
                .btn-primary:hover {
                    background: linear-gradient(135deg, #0f766e 0%, #042f2e 100%) !important;
                    border-color: #0f766e !important;
                }
                /* Hide Upgrade Prompts, Developer Columns and Footers */
                a[href*="odoo.com"], a[href*="odoo"], .o_enterprise_label, .badge.text-bg-warning,
                .o_sub_menu_footer, .oe_footer, .o_footer,
                th[data-name="author"], td[data-name="author"],
                th[data-name="website"], td[data-name="website"] {
                    display: none !important;
                }

                /* Clean Login Screen: Completely eliminate Manage Databases, Passkeys and Placeholders */
                a[href*="database/manager"],
                a[href*="database/selector"],
                a[href*="passkey"],
                button:has([class*="passkey"]),
                div:has(> a[href*="database/manager"]),
                div:has(> a[href*="passkey"]),
                .o_footer_copyright,
                .oe_footer,
                p:has(> a[href*="database/manager"]) {
                    display: none !important;
                }

                /* Replace "Your logo" with official EMS logo */
                .card-body .text-center img,
                .card-body img[alt="Logo"],
                .oe_login_form img {
                    max-height: 54px !important;
                    object-fit: contain !important;
                    content: url("https://app.employeemanagementsystems.com/favicon.ico") !important;
                }
            ]]></style>
        </xpath>
    </template>
</odoo>
